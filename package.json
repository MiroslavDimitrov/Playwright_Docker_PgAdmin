{
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:image": "docker build -t playwright-pg:1.0 .",
    "build": "npm run typecheck && npm run build:image",
    "db:up": "docker-compose up -d --build",
    "db:down": "docker-compose down",
    "test": "playwright test"
  },
  "dependencies": {
    "pg": "^8.17.1",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/pg": "^8.16.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3"
  }
}
