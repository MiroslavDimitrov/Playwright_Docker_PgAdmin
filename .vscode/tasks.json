{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (type-check + Docker image)",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Type-check",
      "type": "npm",
      "script": "typecheck",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Run tests",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Database: start",
      "type": "npm",
      "script": "db:up",
      "problemMatcher": []
    },
    {
      "label": "Database: stop",
      "type": "npm",
      "script": "db:down",
      "problemMatcher": []
    }
  ]
}
